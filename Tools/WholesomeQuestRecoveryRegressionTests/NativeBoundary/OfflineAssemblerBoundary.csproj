<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>fasmdll_managed</AssemblyName>
    <AssemblyVersion>1.0.3262.20709</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>OFFLINE TEST BOUNDARY ONLY: native assembler dispatch is forbidden.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="OfflineBoundary" Value="deny-native-dispatch" />
  </ItemGroup>
</Project>
