-                CleanupHandlers.Pop().Dispose();
+            {
+                try { CleanupHandlers.Pop().Dispose(); }
+                catch (Exception error)
+                {
+                    // Drain all owned cleanup before propagating the original error.
+                    // Stop signals take precedence over ordinary cleanup failures.
