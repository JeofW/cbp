<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BoundaryFixture.cs" />
    <Compile Include="RawObservationBoundary.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Generated/*.cs" />
    <None Include="Generated/source-manifest.json" CopyToOutputDirectory="Always" TargetPath="source-manifest.json" />
  </ItemGroup>
  <Target Name="RequirePinnedSources" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Generated/source-manifest.json')" Text="Run extract_owners.py against an explicit source commit before building. Missing sources are NOT a behavioral regression." />
  </Target>
</Project>
